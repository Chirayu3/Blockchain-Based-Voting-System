# Application
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bbvs
DB_PASSWORD=your_database_password
DB_DATABASE=bbvs

# JWT & OTP Security
ACCESS_TOKEN_SECRET=your_jwt_access_secret_min_64_chars
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_min_64_chars
OTP_HASH_SECRET=your_otp_hmac_secret_min_64_chars

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Blockchain Voting System <your_email@gmail.com>
